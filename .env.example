DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Or, to use TiDB Cloud (MySQL-compatible) instead, comment out the line above and use:
# DATABASE_URL=mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/test
PORT=3000

# Better Auth session/cookie signing secret and the app's own base URL. Generate a secret with
# `openssl rand -base64 32` (or similar) — anyone with it can forge sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Only needed when running `npm run db:migrate`, which copies products/orders from
# SOURCE_DATABASE_URL into TARGET_DATABASE_URL (either Postgres or MySQL/TiDB, in either
# direction). DATABASE_URL above is left untouched by the migration.
# SOURCE_DATABASE_URL=
# TARGET_DATABASE_URL=
